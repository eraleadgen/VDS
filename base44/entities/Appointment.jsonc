{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "service_type": {
      "type": "string",
      "description": "Service key from BusinessConfig catalog"
    },
    "service_label": {
      "type": "string",
      "description": "Human-readable service name"
    },
    "vehicle_info": {
      "type": "string",
      "description": "Vehicle details (year make model)"
    },
    "preferred_date": {
      "type": "string",
      "format": "date",
      "description": "Requested service date"
    },
    "preferred_time": {
      "type": "string",
      "description": "Requested time slot"
    },
    "estimated_duration_minutes": {
      "type": "number",
      "description": "Estimated service duration"
    },
    "technician_id": {
      "type": "string",
      "description": "Assigned technician (from BusinessConfig)"
    },
    "google_calendar_event_id": {
      "type": "string",
      "description": "Google Calendar event ID (source of truth for scheduling)"
    },
    "ghl_appointment_ids": {
      "type": "string",
      "description": "Legacy GHL appointment IDs \u2014 deprecated, removed during GHL migration"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "service_address": {
      "type": "string"
    }
  },
  "required": [
    "service_type",
    "preferred_date",
    "preferred_time",
    "customer_name",
    "customer_phone"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "data.customer_phone": "{{user.phone}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}