{
  "name": "Appointment",
  "type": "object",
  "description": "DEPRECATED scheduling mirror. The Job entity is now the operational source of truth. This entity is retained temporarily for scheduler and specialist portal compatibility during the ERA Core migration. New bookings create a Job first, with this Appointment as a linked scheduling component. Scheduled for removal after the scheduler and specialist portal migrate to operate on Jobs directly.",
  "properties": {
    "business_id": {
      "type": "string",
      "default": "vds",
      "description": "Tenant scope. Set on creation so entity RLS can match the user's tenant."
    },
    "job_id": {
      "type": "string",
      "description": "Linked Job entity ID (the operational source of truth). Set when this Appointment is created as a deprecated mirror of a Job."
    },
    "service_type": {
      "type": "string",
      "description": "Service key from BusinessConfig catalog"
    },
    "service_label": {
      "type": "string",
      "description": "Human-readable service name"
    },
    "vehicle_info": {
      "type": "string",
      "description": "Vehicle details (year make model)"
    },
    "preferred_date": {
      "type": "string",
      "format": "date",
      "description": "Requested service date"
    },
    "preferred_time": {
      "type": "string",
      "description": "Requested time slot (zoned HH:MM)"
    },
    "estimated_duration_minutes": {
      "type": "number",
      "description": "Estimated service duration"
    },
    "contractor_id": {
      "type": "string",
      "description": "Assigned contractor (Contractor entity id)"
    },
    "contractor_name": {
      "type": "string",
      "description": "Assigned contractor name (denormalized for display + Google Calendar)"
    },
    "job_status": {
      "type": "string",
      "enum": [
        "assigned",
        "accepted",
        "driving",
        "arrived",
        "in_progress",
        "quality_check",
        "completed",
        "photos_uploaded",
        "invoice_complete"
      ],
      "default": "assigned",
      "description": "Contractor job workflow status (replaces clock in/out)"
    },
    "service_county": {
      "type": "string",
      "description": "County of the service address (used for contractor service-area matching)"
    },
    "before_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Before photos (URLs)"
    },
    "after_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "After photos (URLs)"
    },
    "services_completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "products_used": {
      "type": "string",
      "description": "Products used (optional, free text)"
    },
    "completion_notes": {
      "type": "string",
      "description": "Additional notes submitted on completion"
    },
    "upsell_recommendation": {
      "type": "string",
      "description": "Upsell recommendation from contractor"
    },
    "recommended_next_detail_date": {
      "type": "string",
      "format": "date",
      "description": "Recommended next detail date"
    },
    "damage_notes": {
      "type": "string",
      "description": "Pre-existing damage notes (optional)"
    },
    "customer_feedback": {
      "type": "string",
      "description": "Customer feedback captured at completion (optional)"
    },
    "review_requested": {
      "type": "boolean",
      "default": false,
      "description": "True once a review-request SMS has been sent to the customer for this job"
    },
    "review_submitted": {
      "type": "boolean",
      "default": false,
      "description": "True once the customer has submitted a review for this job"
    },
    "reminder_24h_email_sent": {
      "type": "boolean",
      "default": false,
      "description": "True once the 24-hour email reminder has been sent to the customer."
    },
    "reminder_1h_sms_sent": {
      "type": "boolean",
      "default": false,
      "description": "True once the 1-hour reminder (SMS or email fallback) has been sent to the customer."
    },
    "sms_consent": {
      "type": "boolean",
      "default": true,
      "description": "True if the customer consented to receive SMS messages. When false, all customer-facing notifications (confirmations, reminders, quotes) are sent via email instead of SMS."
    },
    "google_calendar_event_id": {
      "type": "string",
      "description": "Google Calendar event ID (event mirror source of truth)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "service_address": {
      "type": "string"
    }
  },
  "required": [
    "business_id",
    "service_type",
    "preferred_date",
    "preferred_time",
    "customer_name",
    "customer_phone"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.customer_email": "{{user.email}}"
            },
            {
              "data.customer_phone": "{{user.data.phone}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}