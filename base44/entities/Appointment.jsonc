{
  "name": "Appointment",
  "type": "object",
  "description": "Customer appointment. Auto-assigned to an available contractor by the scheduling engine and mirrored to Google Calendar. Tracks the contractor job workflow (assigned -> completed) and job-completion details in place of clock in/out.",
  "properties": {
    "service_type": {
      "type": "string",
      "description": "Service key from BusinessConfig catalog"
    },
    "service_label": {
      "type": "string",
      "description": "Human-readable service name"
    },
    "vehicle_info": {
      "type": "string",
      "description": "Vehicle details (year make model)"
    },
    "preferred_date": {
      "type": "string",
      "format": "date",
      "description": "Requested service date"
    },
    "preferred_time": {
      "type": "string",
      "description": "Requested time slot (zoned HH:MM)"
    },
    "estimated_duration_minutes": {
      "type": "number",
      "description": "Estimated service duration"
    },
    "contractor_id": {
      "type": "string",
      "description": "Assigned contractor (Contractor entity id)"
    },
    "contractor_name": {
      "type": "string",
      "description": "Assigned contractor name (denormalized for display + Google Calendar)"
    },
    "job_status": {
      "type": "string",
      "enum": [
        "assigned",
        "accepted",
        "driving",
        "arrived",
        "in_progress",
        "quality_check",
        "completed",
        "photos_uploaded",
        "invoice_complete"
      ],
      "default": "assigned",
      "description": "Contractor job workflow status (replaces clock in/out)"
    },
    "service_county": {
      "type": "string",
      "description": "County of the service address (used for contractor service-area matching)"
    },
    "before_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Before photos (URLs)"
    },
    "after_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "After photos (URLs)"
    },
    "services_completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "products_used": {
      "type": "string",
      "description": "Products used (optional, free text)"
    },
    "completion_notes": {
      "type": "string",
      "description": "Additional notes submitted on completion"
    },
    "upsell_recommendation": {
      "type": "string",
      "description": "Upsell recommendation from contractor"
    },
    "recommended_next_detail_date": {
      "type": "string",
      "format": "date",
      "description": "Recommended next detail date"
    },
    "damage_notes": {
      "type": "string",
      "description": "Pre-existing damage notes (optional)"
    },
    "customer_feedback": {
      "type": "string",
      "description": "Customer feedback captured at completion (optional)"
    },
    "review_requested": {
      "type": "boolean",
      "default": false,
      "description": "True once a review-request SMS has been sent to the customer for this job"
    },
    "review_submitted": {
      "type": "boolean",
      "default": false,
      "description": "True once the customer has submitted a review for this job"
    },
    "google_calendar_event_id": {
      "type": "string",
      "description": "Google Calendar event ID (event mirror source of truth)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "service_address": {
      "type": "string"
    }
  },
  "required": [
    "service_type",
    "preferred_date",
    "preferred_time",
    "customer_name",
    "customer_phone"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "data.customer_phone": "{{user.phone}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}