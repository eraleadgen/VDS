{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "is_gold_member": {
      "type": "boolean",
      "description": "Whether this user has an active VDS Gold membership",
      "default": false
    }
  },
  "required": [
    "role"
  ]
}