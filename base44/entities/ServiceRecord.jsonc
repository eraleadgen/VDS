{
  "name": "ServiceRecord",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "default": "vds",
      "description": "Tenant scope. Set on creation so entity RLS can match the user's tenant."
    },
    "vehicle_id": {
      "type": "string",
      "description": "ID of the MemberVehicle"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "full_detail",
        "exterior_detail"
      ],
      "description": "Type of service performed"
    },
    "service_date": {
      "type": "string",
      "format": "date",
      "description": "Date service was performed"
    },
    "month_year": {
      "type": "string",
      "description": "Billing month in YYYY-MM format"
    },
    "notes": {
      "type": "string",
      "description": "Admin notes about the service"
    }
  },
  "required": [
    "business_id",
    "vehicle_id",
    "service_type",
    "service_date",
    "month_year"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}