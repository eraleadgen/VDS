{
  "name": "Customer",
  "type": "object",
  "description": "Central CRM entity for ERA Core. Stores all customer profile information, communication preferences, lifetime value, consent, review status, and relationship references. The built-in User entity handles authentication only; this entity holds all business/CRM data. ERA Core is the system of record for all customer data.",
  "properties": {
    "business_id": {
      "type": "string",
      "default": "vds",
      "description": "Tenant scope. Set on creation so entity RLS can match the user's tenant."
    },
    "linked_user_id": {
      "type": "string",
      "description": "ID of the built-in Base44 User this customer authenticates as. Null for guest customers who have not yet registered."
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "sms",
        "email",
        "phone",
        "none"
      ],
      "default": "sms",
      "description": "Customer's preferred channel for automated communications"
    },
    "billing_address": {
      "type": "string"
    },
    "service_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Saved service addresses for this customer"
    },
    "notes": {
      "type": "string"
    },
    "marketing_preferences": {
      "type": "object",
      "properties": {
        "email_promotions": {
          "type": "boolean",
          "default": false
        },
        "sms_promotions": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "sms_consent": {
      "type": "boolean",
      "default": true,
      "description": "True if the customer consented to receive SMS messages. Evaluated by the Communication Rules Engine before any SMS is sent."
    },
    "email_consent": {
      "type": "boolean",
      "default": true,
      "description": "True if the customer consented to receive email messages."
    },
    "review_status": {
      "type": "string",
      "enum": [
        "no_review",
        "review_requested",
        "review_submitted",
        "review_declined",
        "review_opt_out"
      ],
      "default": "no_review",
      "description": "Customer review status. Referenced before any review-related workflow. After review_submitted, future review requests are permanently suppressed unless admin-overridden."
    },
    "customer_since": {
      "type": "string",
      "format": "date",
      "description": "Date the customer relationship began"
    },
    "lifetime_revenue": {
      "type": "number",
      "default": 0,
      "description": "Total revenue generated by this customer across all jobs and memberships. Updated as invoices are paid."
    },
    "total_jobs": {
      "type": "number",
      "default": 0,
      "description": "Total number of completed jobs for this customer."
    },
    "referral_source": {
      "type": "string",
      "description": "How the customer found the business (e.g. Google, Instagram, Referral, etc.)"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "blocked"
      ],
      "default": "active"
    },
    "referred_by_partner_id": {
      "type": "string",
      "description": "Partner entity ID this customer was referred by. Set automatically the first time the customer books via a partner referral link. Drives attribution for ALL future jobs \u2014 including a ceramic-coating or paint-correction purchase made after a consultation \u2014 so the referring partner always gets credit."
    }
  },
  "required": [
    "business_id",
    "first_name",
    "last_name",
    "phone"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.linked_user_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.linked_user_id": "{{user.id}}"
        },
        {
          "data.phone": "{{user.data.phone}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.linked_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}