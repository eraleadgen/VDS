{
  "name": "PartnerReferral",
  "type": "object",
  "description": "Tracks a single Partner Network referral event. Created when a customer books via a partner's referral link (status 'referred'). Attributed (status 'converted', attributed=true) when the linked job's invoice is paid \u2014 crediting the partner's conversions, revenue, and service-type counters, plus the earned incentive. Powers accurate, idempotent partner metrics and incentive payouts.",
  "properties": {
    "business_id": {
      "type": "string",
      "default": "vds",
      "description": "Tenant scope. Set on creation so entity RLS can match the user's tenant."
    },
    "partner_id": {
      "type": "string",
      "description": "Partner entity ID this referral belongs to."
    },
    "customer_id": {
      "type": "string",
      "description": "Customer entity ID referred."
    },
    "job_id": {
      "type": "string",
      "description": "Job entity ID this referral originated from."
    },
    "service_package": {
      "type": "string",
      "description": "Service key of the job at referral time."
    },
    "status": {
      "type": "string",
      "enum": [
        "referred",
        "converted"
      ],
      "default": "referred"
    },
    "revenue": {
      "type": "number",
      "default": 0,
      "description": "Revenue attributed when converted (invoice final_amount)."
    },
    "attributed": {
      "type": "boolean",
      "default": false,
      "description": "True once partner metrics have been credited for this referral (idempotency flag preventing double-counting)."
    },
    "incentive_type": {
      "type": "string",
      "enum": [
        "initial_detail",
        "ceramic_coating",
        "paint_correction",
        "none"
      ],
      "default": "none",
      "description": "Which incentive tier this referral earned. 'initial_detail' is paid once per referred client; ceramic_coating and paint_correction are paid per qualifying job."
    },
    "incentive_amount": {
      "type": "number",
      "default": 0,
      "description": "Incentive payout credited for this referral (0 if none \u2014 e.g. a repeat detail past the one-time initial detail incentive)."
    }
  },
  "required": [
    "business_id",
    "partner_id",
    "customer_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}