{
  "name": "SystemEventLog",
  "type": "object",
  "description": "Immutable audit trail of all significant platform events and suppressed communications. Every event-driven workflow generates an entry here. Every communication suppressed by the Communication Rules Engine is recorded with its suppression reason. This entity is the foundation of ERA Core's event-driven architecture.",
  "properties": {
    "event_type": {
      "type": "string",
      "description": "Standardized event type. Examples: customer_created, quote_requested, quote_approved, job_assigned, job_completed, invoice_paid, membership_activated, appointment_scheduled, appointment_cancelled, message_sent, message_suppressed, milestone_reached, review_submitted."
    },
    "entity_type": {
      "type": "string",
      "description": "Type of entity involved (customer, job, quote, membership, invoice, etc.)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the primary entity involved"
    },
    "customer_id": {
      "type": "string",
      "description": "Related customer ID (if applicable, for customer-centric queries)"
    },
    "description": {
      "type": "string",
      "description": "Human-readable event description"
    },
    "metadata": {
      "type": "object",
      "description": "Additional structured context for the event"
    },
    "suppression_reason": {
      "type": "string",
      "description": "If this event records a suppressed communication, the reason it was blocked (e.g. no_sms_consent, duplicate_reminder, review_opt_out, opted_out_promotions)."
    }
  },
  "required": [
    "event_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}