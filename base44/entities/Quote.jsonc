{
  "name": "Quote",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "vehicle_year": {
      "type": "string"
    },
    "vehicle_make": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "sedan_coupe",
        "truck_suv"
      ]
    },
    "requested_services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Service keys from BusinessConfig catalog"
    },
    "starting_price": {
      "type": "number",
      "description": "Sum of service starting prices"
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "description": "Dollar discount applied"
    },
    "discount_reason": {
      "type": "string"
    },
    "membership_discount_applied": {
      "type": "boolean",
      "default": false
    },
    "upsells": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Add-on service keys offered"
    },
    "final_price": {
      "type": "number",
      "description": "starting_price - discount_amount (+ upsells if priced)"
    },
    "quote_summary": {
      "type": "string"
    },
    "booking_url": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Quote validity date"
    },
    "ai_notes": {
      "type": "string",
      "description": "Notes from the Valerie interaction"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "booked",
        "expired",
        "declined"
      ],
      "default": "pending"
    },
    "sms_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "customer_phone",
    "requested_services"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_phone": "{{user.data.phone}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}