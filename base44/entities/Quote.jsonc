{
  "type": "object",
  "name": "Quote",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "vehicle_year": {
      "type": "string"
    },
    "vehicle_make": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "sedan_coupe",
        "truck_suv"
      ]
    },
    "requested_services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of requested service keys"
    },
    "starting_price": {
      "type": "number"
    },
    "quote_summary": {
      "type": "string"
    },
    "booking_url": {
      "type": "string"
    },
    "ai_notes": {
      "type": "string",
      "description": "Notes from the AI interaction"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "booked",
        "expired"
      ],
      "default": "pending"
    },
    "sms_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "customer_phone",
    "requested_services"
  ]
}