{
  "name": "Quote",
  "type": "object",
  "description": "Pricing quote generated by the dynamic pricing engine. A draft quote (status 'pending') is created from the Pricing page 'Book This Quote' button \u2014 it stores the selected services, vehicle classification, condition, paint protection, and computed price. The booking page fills in customer details. Admin can finalize the final_price in the admin portal.",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "vehicle_classification": {
      "type": "string",
      "enum": [
        "coupe",
        "sedan",
        "hatchback",
        "mid_size_suv",
        "truck_3_row_suv",
        "other"
      ],
      "description": "Vehicle classification selected on the pricing page"
    },
    "vehicle_year": {
      "type": "string"
    },
    "vehicle_make": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "sedan_coupe",
        "truck_suv"
      ],
      "description": "Pricing group resolved from vehicle_classification"
    },
    "requested_services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Service keys from BusinessConfig catalog"
    },
    "add_ons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Add-on service keys selected on the pricing page"
    },
    "condition": {
      "type": "string",
      "description": "Vehicle condition key (e.g. light, moderate, heavy) selected on the pricing page"
    },
    "paint_protection": {
      "type": "string",
      "enum": [
        "none",
        "paint_protection"
      ],
      "default": "none",
      "description": "Existing paint protection on the vehicle (PPF or ceramic coating), selected on the quote/book page. When set to paint_protection, a 20% discount is applied to the detail service base price."
    },
    "starting_price": {
      "type": "number",
      "description": "Sum of service starting prices (before condition multiplier)"
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "description": "Dollar discount applied"
    },
    "discount_reason": {
      "type": "string"
    },
    "membership_discount_applied": {
      "type": "boolean",
      "default": false
    },
    "upsells": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Add-on service keys offered"
    },
    "final_price": {
      "type": "number",
      "description": "The computed custom quote \u2014 base services \u00d7 condition multiplier + add-ons \u2212 paint protection discount. Admin can override this when finalizing."
    },
    "estimated_duration_minutes": {
      "type": "number",
      "description": "Estimated total service duration"
    },
    "quote_summary": {
      "type": "string"
    },
    "job_id": {
      "type": "string",
      "description": "Linked Job entity ID once the quote is booked"
    },
    "booking_url": {
      "type": "string"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Quote validity date"
    },
    "ai_notes": {
      "type": "string",
      "description": "Notes from the Valerie interaction"
    },
    "sms_consent": {
      "type": "boolean",
      "default": true,
      "description": "True if the customer consented to receive SMS messages. When false, the quote is delivered via email instead of SMS."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "booked",
        "finalized",
        "expired",
        "declined"
      ],
      "default": "pending"
    },
    "sms_sent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "requested_services"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_phone": "{{user.data.phone}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}