{
  "name": "VehicleSubscription",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string",
      "description": "ID of the MemberVehicle"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "tier": {
      "type": "string",
      "enum": [
        "sedan_coupe",
        "truck_suv"
      ],
      "description": "Subscription tier"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "canceled",
        "past_due",
        "trialing"
      ],
      "default": "active",
      "description": "Subscription status"
    },
    "started_date": {
      "type": "string",
      "format": "date",
      "description": "Subscription start date"
    },
    "current_period_end": {
      "type": "string",
      "format": "date",
      "description": "Current billing period end date"
    }
  },
  "required": [
    "vehicle_id",
    "stripe_subscription_id",
    "tier",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.vehicle_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}