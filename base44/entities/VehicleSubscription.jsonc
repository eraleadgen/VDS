{
  "name": "VehicleSubscription",
  "type": "object",
  "description": "Active recurring VDS Gold membership for a single vehicle. Each vehicle enrolled in a checkout gets its own VehicleSubscription record pointing at the shared Stripe subscription, with its individual stripe_item_id so a single vehicle can be canceled without affecting other vehicles on the same subscription. Only one active VDS Gold membership may exist per vehicle.",
  "properties": {
    "vehicle_id": {
      "type": "string",
      "description": "ID of the MemberVehicle"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer entity ID that owns this subscription"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID. Shared across vehicles enrolled in the same checkout (one subscription, multiple line items)."
    },
    "stripe_item_id": {
      "type": "string",
      "description": "Stripe subscription item ID (si_...) for this vehicle's line item on the shared subscription. Used to cancel a single vehicle's membership without canceling other vehicles on the same subscription."
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "Stripe Price ID for this subscription's pricing group (references the single VDS Gold Membership product)"
    },
    "pricing_group": {
      "type": "string",
      "enum": [
        "sedan_coupe",
        "truck_suv"
      ],
      "description": "Pricing group for this subscription. Determined from the vehicle's classification via BusinessConfig mapping."
    },
    "tier": {
      "type": "string",
      "enum": [
        "sedan_coupe",
        "truck_suv"
      ],
      "description": "Legacy field. Retained for backward compatibility; new code should use pricing_group."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "canceled",
        "past_due",
        "trialing"
      ],
      "default": "active"
    },
    "started_date": {
      "type": "string",
      "format": "date"
    },
    "current_period_end": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "description": "Optional notes about this subscription",
      "maxLength": 1000
    }
  },
  "required": [
    "vehicle_id",
    "stripe_subscription_id",
    "pricing_group",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}