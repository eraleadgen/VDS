{
  "name": "BusinessConfig",
  "type": "object",
  "description": "Single source of truth for all business configuration \u2014 vehicle classifications, pricing groups, services, pricing rules, memberships, hours, scheduling rules, feature flags, branding, domain dictionary, AI concierge persona, SEO copy, and FAQ content. Designed multi-tenant (business_id) for the ERA Systems future. Business behavior is configurable here, not hardcoded. VDS Mobile is a configuration layer over ERA Core.",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "Unique identifier for this business (multi-tenant future)",
      "default": "vds"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Only one active config per business_id"
    },
    "business_name": {
      "type": "string",
      "default": "VDS Mobile"
    },
    "legal_name": {
      "type": "string",
      "description": "Legal entity name for copyright lines, footer legal notices, and contracts. May differ from the brand display name (business_name); e.g. VDS brand is 'VDS Mobile' but legal entity is 'Valet Detailing Service LLC'. Generic tenants often set legal_name = business_name."
    },
    "legal_jurisdiction": {
      "type": "string",
      "description": "State/region where the business is legally registered (e.g. 'Georgia'). Used in legal notices, Terms jurisdiction clauses, and 'registered LLC in {legal_jurisdiction}' phrasing. Populated by the onboarding wizard."
    },
    "logo_url": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "brand_colors": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "business_phone": {
      "type": "string"
    },
    "business_email": {
      "type": "string"
    },
    "business_address": {
      "type": "string",
      "description": "Free-text display address (e.g. 'Metro Atlanta, GA'). For structured needs (JSON-LD PostalAddress, legal jurisdiction) use address_locality / address_region / address_country."
    },
    "address_locality": {
      "type": "string",
      "description": "Structured locality/city for JSON-LD PostalAddress (e.g. 'Alpharetta'). Populated by the onboarding wizard."
    },
    "address_region": {
      "type": "string",
      "description": "Structured state/region for JSON-LD PostalAddress (e.g. 'GA')."
    },
    "address_country": {
      "type": "string",
      "description": "ISO country code for JSON-LD PostalAddress (e.g. 'US')."
    },
    "service_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "business_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "open": {
            "type": "string",
            "description": "HH:MM 24h"
          },
          "close": {
            "type": "string",
            "description": "HH:MM 24h"
          },
          "closed": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "scheduling_rules": {
      "type": "object",
      "properties": {
        "booking_buffer_hours": {
          "type": "number",
          "default": 24
        },
        "min_notice_hours": {
          "type": "number",
          "default": 24
        },
        "cancellation_hours": {
          "type": "number",
          "default": 48
        },
        "slot_interval_minutes": {
          "type": "number",
          "default": 60
        },
        "max_bookings_per_day": {
          "type": "number",
          "default": 4
        }
      }
    },
    "pricing_rules": {
      "type": "object",
      "description": "Pricing engine rules \u2014 condition multipliers applied to computed quotes based on vehicle condition. The dynamic quote factors in vehicle size (classification), condition, add-ons, and services requested.",
      "properties": {
        "condition_multipliers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "multiplier": {
                "type": "number"
              },
              "duration_add_minutes": {
                "type": "number",
                "description": "Extra estimated minutes added to base service duration for this vehicle condition."
              }
            }
          }
        }
      }
    },
    "vehicle_classifications": {
      "type": "array",
      "description": "Operational vehicle classifications. Independent from pricing groups. Drives scheduling and specialist matching. VDS Mobile v1.0 uses 4 classifications.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "coupe",
              "sedan",
              "hatchback",
              "mid_size_suv",
              "truck_3_row_suv",
              "other"
            ]
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "pricing_groups": {
      "type": "array",
      "description": "Pricing groups. Independently configurable from vehicle classifications. Drives all service pricing and Stripe membership pricing. VDS Mobile v1.0 uses 2 pricing groups.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "sedan_coupe",
              "truck_suv"
            ]
          },
          "label": {
            "type": "string"
          },
          "stripe_price_id": {
            "type": "string",
            "description": "Stripe Price ID for VDS Gold membership at this pricing group"
          }
        }
      }
    },
    "classification_to_pricing_group": {
      "type": "object",
      "description": "Mapping from vehicle classification to pricing group. Configurable through the Administration Module \u2014 not hardcoded. hatchback maps to sedan_coupe (priced same as coupe); other maps to sedan_coupe as a base default (adjust per business).",
      "properties": {
        "coupe": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        },
        "sedan": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        },
        "hatchback": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        },
        "mid_size_suv": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        },
        "truck_3_row_suv": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        },
        "other": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        }
      }
    },
    "vehicle_types": {
      "type": "array",
      "description": "Legacy vehicle type list. Retained for backward compatibility during migration. New code should use vehicle_classifications + pricing_groups.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "feature_flags": {
      "type": "object",
      "description": "Platform feature flags \u2014 toggle integrations and capabilities without code changes.",
      "properties": {
        "twilio_sms_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Master switch for Twilio SMS delivery. Must be false until A2P registration is approved. When false, all SMS are suppressed and routed to email fallback (or logged as suppressed)."
        },
        "gold_checkout_enabled": {
          "type": "boolean",
          "default": true
        },
        "instant_quote_enabled": {
          "type": "boolean",
          "default": true
        },
        "review_requests_enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "services": {
      "type": "array",
      "description": "Master service catalog. Service definitions contain NO pricing logic \u2014 pricing is resolved by the Pricing Engine using service key + pricing group (or per-classification tiers). All pricing originates here and never in code.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "detail",
              "coating",
              "correction",
              "addon",
              "membership",
              "consultation"
            ]
          },
          "requires_consultation": {
            "type": "boolean",
            "default": false
          },
          "tiers": {
            "type": "array",
            "description": "Pricing per pricing group OR per vehicle classification. When a tier's key matches the vehicle classification it takes priority; otherwise the pricing group match is used. The Pricing Engine reads this; services never calculate their own price.",
            "items": {
              "type": "object",
              "properties": {
                "tier": {
                  "type": "string",
                  "description": "Pricing group key or vehicle classification key"
                },
                "price": {
                  "type": "number",
                  "description": "Starting price"
                },
                "duration_minutes": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "featured_services": {
      "type": "array",
      "description": "Curated marketing service cards shown on the Home and Services pages. Each card references an operational service (service_key) and an optional booking preselect key, plus display-only fields (title, subtitle, image, spec list, not-in-membership flag). The onboarding wizard authors these; the operational `services` catalog drives pricing/booking. Components validate that service_key/booking_preselect still exist in the services catalog and flag stale references instead of silently breaking the booking preselect.",
      "items": {
        "type": "object",
        "properties": {
          "service_key": {
            "type": "string",
            "description": "Operational service key this card represents (validated against the services catalog)."
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "specs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "not_in_membership": {
            "type": "boolean",
            "default": false,
            "description": "True if this service is not included in the membership (Home card shows the 'Not included' upsell instead of the membership CTA)."
          },
          "booking_preselect": {
            "type": "string",
            "description": "Service key passed to the booking page as preselect_service. Defaults to service_key if unset. Validated against the services catalog."
          },
          "display_order": {
            "type": "number"
          }
        },
        "required": [
          "service_key",
          "title"
        ]
      }
    },
    "membership_plans": {
      "type": "array",
      "description": "Recurring membership plans. VDS Gold is the initial implementation. Each plan references ONE Stripe product with per-pricing-group pricing. Vehicle classifications map to pricing groups via classification_to_pricing_group \u2014 never hardcoded.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "short_label": {
            "type": "string",
            "description": "Short brand form for nav links and compact CTAs (e.g. 'VDS Gold'), distinct from the full marketing label (e.g. 'VDS Gold Membership'). Falls back to label when unset."
          },
          "stripe_product_id": {
            "type": "string",
            "description": "Single Stripe product ID for this membership plan"
          },
          "pricing_by_group": {
            "type": "array",
            "description": "Monthly price per pricing group, each with its own Stripe Price ID.",
            "items": {
              "type": "object",
              "properties": {
                "pricing_group": {
                  "type": "string",
                  "enum": [
                    "sedan_coupe",
                    "truck_suv"
                  ]
                },
                "price_monthly": {
                  "type": "number"
                },
                "stripe_price_id": {
                  "type": "string"
                }
              }
            }
          },
          "benefits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "technicians": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        }
      }
    },
    "referral_program": {
      "type": "object",
      "description": "Partner Network incentive program. Configurable payouts: $30 for the initial (first) detail per referred client (one-time per client), $100 for each ceramic coating or paint correction job. Adjust payouts here without code changes.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "credit_amount": {
          "type": "number"
        },
        "incentives": {
          "type": "object",
          "description": "Partner incentive payouts. The 'initial_detail' incentive is paid once per referred client; ceramic_coating and paint_correction are paid per qualifying job.",
          "properties": {
            "initial_detail": {
              "type": "number",
              "default": 30,
              "description": "One-time payout for the referred client's initial detail."
            },
            "ceramic_coating": {
              "type": "number",
              "default": 100,
              "description": "Payout per ceramic coating job converted."
            },
            "paint_correction": {
              "type": "number",
              "default": 100,
              "description": "Payout per paint correction job converted."
            }
          }
        }
      }
    },
    "website_links": {
      "type": "object",
      "properties": {
        "booking_url": {
          "type": "string"
        },
        "gold_signup_url": {
          "type": "string"
        },
        "gallery_url": {
          "type": "string"
        },
        "google_review_url": {
          "type": "string",
          "description": "Google Business review link included in review-request messages to customers after a completed job."
        }
      }
    },
    "social_links": {
      "type": "object",
      "properties": {
        "instagram": {
          "type": "string"
        },
        "tiktok": {
          "type": "string"
        }
      }
    },
    "seo": {
      "type": "array",
      "description": "Per-route SEO meta entries (page title + meta description), keyed by route path. Populated by the onboarding wizard \u2014 this is marketing copy, not auto-generated. RouteSeo finds the entry whose route matches the current path; routes without an entry are treated as noindex.",
      "items": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string",
            "description": "Route path (e.g. '/', '/services')"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "faq": {
      "type": "array",
      "description": "FAQ entries (question + answer) shown on the FAQ page and emitted as FAQPage JSON-LD structured data. Populated by the onboarding wizard \u2014 this is content, not auto-generated.",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "dictionary": {
      "type": "object",
      "description": "White-label domain vocabulary for UI copy. Lets a non-automotive tenant rebrand surface language ('vehicle' -> 'item', 'classification' -> 'category', 'detail' -> 'service') without renaming entities or service keys, which remain stable literals. Components read these via useDictionary(); defaults keep the VDS automotive voice.",
      "properties": {
        "item_noun": {
          "type": "string",
          "default": "Vehicle",
          "description": "Singular noun for the serviced thing (a MemberVehicle). 'Vehicle' for VDS; 'Item' generically."
        },
        "item_plural": {
          "type": "string",
          "default": "Vehicles"
        },
        "item_category_noun": {
          "type": "string",
          "default": "Classification",
          "description": "Noun for vehicle_classification. 'Classification' for VDS; 'Category' generically."
        },
        "item_category_label": {
          "type": "string",
          "default": "Vehicle Classification",
          "description": "Human-facing label for the classification selector and display headings."
        },
        "service_noun": {
          "type": "string",
          "default": "Detail",
          "description": "Noun for a single service instance. 'Detail' for VDS; 'Service' generically."
        },
        "service_verb": {
          "type": "string",
          "default": "detail",
          "description": "Verb for performing the service ('detail the vehicle' / 'service the item')."
        },
        "service_area_noun": {
          "type": "string",
          "default": "Service Area"
        },
        "before_photo_label": {
          "type": "string",
          "default": "Before"
        },
        "after_photo_label": {
          "type": "string",
          "default": "After"
        },
        "appointment_noun": {
          "type": "string",
          "default": "Appointment",
          "description": "Noun for a scheduled visit ('Appointment' / 'Visit')."
        }
      }
    },
    "concierge": {
      "type": "object",
      "description": "AI concierge persona and branding. The valerie backend function builds its system prompt from these fields instead of hardcoded 'Valerie' literals. Display name also appears in admin messaging UI and customer-facing message attribution.",
      "properties": {
        "name": {
          "type": "string",
          "default": "Valerie",
          "description": "Concierge display name."
        },
        "persona": {
          "type": "string",
          "description": "Short personality description injected into the LLM system prompt."
        },
        "business_summary": {
          "type": "string",
          "description": "One-paragraph business context so the concierge speaks correctly about services, pricing, and policies."
        },
        "greeting": {
          "type": "string",
          "description": "Default opening line for new conversations."
        }
      }
    }
  },
  "required": [
    "business_id",
    "is_active",
    "business_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}