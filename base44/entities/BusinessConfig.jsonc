{
  "name": "BusinessConfig",
  "type": "object",
  "description": "Single source of truth for all business configuration \u2014 vehicle classifications, pricing groups, services, pricing rules, memberships, hours, scheduling rules, feature flags, and branding. Designed multi-tenant (business_id) for the ERA Systems future. Business behavior is configurable here, not hardcoded. VDS Mobile is a configuration layer over ERA Core.",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "Unique identifier for this business (multi-tenant future)",
      "default": "vds"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Only one active config per business_id"
    },
    "business_name": {
      "type": "string",
      "default": "VDS Mobile"
    },
    "logo_url": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "brand_colors": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "business_phone": {
      "type": "string"
    },
    "business_email": {
      "type": "string"
    },
    "business_address": {
      "type": "string"
    },
    "service_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "business_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "open": {
            "type": "string",
            "description": "HH:MM 24h"
          },
          "close": {
            "type": "string",
            "description": "HH:MM 24h"
          },
          "closed": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "scheduling_rules": {
      "type": "object",
      "properties": {
        "booking_buffer_hours": {
          "type": "number",
          "default": 24
        },
        "min_notice_hours": {
          "type": "number",
          "default": 24
        },
        "cancellation_hours": {
          "type": "number",
          "default": 48
        },
        "slot_interval_minutes": {
          "type": "number",
          "default": 60
        },
        "max_bookings_per_day": {
          "type": "number",
          "default": 4
        }
      }
    },
    "pricing_rules": {
      "type": "object",
      "description": "Pricing engine rules \u2014 condition multipliers applied to computed quotes based on vehicle condition. The dynamic quote factors in vehicle size (classification), condition, add-ons, and services requested.",
      "properties": {
        "condition_multipliers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "multiplier": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "vehicle_classifications": {
      "type": "array",
      "description": "Operational vehicle classifications. Independent from pricing groups. Drives scheduling and specialist matching. VDS Mobile v1.0 uses 4 classifications.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "coupe",
              "sedan",
              "mid_size_suv",
              "truck_3_row_suv"
            ]
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "pricing_groups": {
      "type": "array",
      "description": "Pricing groups. Independently configurable from vehicle classifications. Drives all service pricing and Stripe membership pricing. VDS Mobile v1.0 uses 2 pricing groups.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "sedan_coupe",
              "truck_suv"
            ]
          },
          "label": {
            "type": "string"
          },
          "stripe_price_id": {
            "type": "string",
            "description": "Stripe Price ID for VDS Gold membership at this pricing group"
          }
        }
      }
    },
    "classification_to_pricing_group": {
      "type": "object",
      "description": "Mapping from vehicle classification to pricing group. Configurable through the Administration Module \u2014 not hardcoded.",
      "properties": {
        "coupe": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        },
        "sedan": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        },
        "mid_size_suv": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        },
        "truck_3_row_suv": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        }
      }
    },
    "vehicle_types": {
      "type": "array",
      "description": "Legacy vehicle type list. Retained for backward compatibility during migration. New code should use vehicle_classifications + pricing_groups.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "feature_flags": {
      "type": "object",
      "description": "Platform feature flags \u2014 toggle integrations and capabilities without code changes.",
      "properties": {
        "twilio_sms_enabled": {
          "type": "boolean",
          "default": false,
          "description": "Master switch for Twilio SMS delivery. Must be false until A2P registration is approved. When false, all SMS are suppressed and routed to email fallback (or logged as suppressed)."
        },
        "gold_checkout_enabled": {
          "type": "boolean",
          "default": true
        },
        "instant_quote_enabled": {
          "type": "boolean",
          "default": true
        },
        "review_requests_enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "services": {
      "type": "array",
      "description": "Master service catalog. Service definitions contain NO pricing logic \u2014 pricing is resolved by the Pricing Engine using service key + pricing group (or per-classification tiers). All pricing originates here and never in code.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "detail",
              "coating",
              "correction",
              "addon",
              "membership",
              "consultation"
            ]
          },
          "requires_consultation": {
            "type": "boolean",
            "default": false
          },
          "tiers": {
            "type": "array",
            "description": "Pricing per pricing group OR per vehicle classification. When a tier's key matches the vehicle classification it takes priority; otherwise the pricing group match is used. The Pricing Engine reads this; services never calculate their own price.",
            "items": {
              "type": "object",
              "properties": {
                "tier": {
                  "type": "string",
                  "description": "Pricing group key or vehicle classification key"
                },
                "price": {
                  "type": "number",
                  "description": "Starting price"
                },
                "duration_minutes": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "membership_plans": {
      "type": "array",
      "description": "Recurring membership plans. VDS Gold is the initial implementation. Each plan references ONE Stripe product with per-pricing-group pricing. Vehicle classifications map to pricing groups via classification_to_pricing_group \u2014 never hardcoded.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "stripe_product_id": {
            "type": "string",
            "description": "Single Stripe product ID for this membership plan"
          },
          "pricing_by_group": {
            "type": "array",
            "description": "Monthly price per pricing group, each with its own Stripe Price ID.",
            "items": {
              "type": "object",
              "properties": {
                "pricing_group": {
                  "type": "string",
                  "enum": [
                    "sedan_coupe",
                    "truck_suv"
                  ]
                },
                "price_monthly": {
                  "type": "number"
                },
                "stripe_price_id": {
                  "type": "string"
                }
              }
            }
          },
          "benefits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "technicians": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        }
      }
    },
    "referral_program": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "credit_amount": {
          "type": "number"
        }
      }
    },
    "website_links": {
      "type": "object",
      "properties": {
        "booking_url": {
          "type": "string"
        },
        "gold_signup_url": {
          "type": "string"
        },
        "gallery_url": {
          "type": "string"
        }
      }
    },
    "social_links": {
      "type": "object",
      "properties": {
        "instagram": {
          "type": "string"
        },
        "tiktok": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "business_id",
    "is_active",
    "business_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}