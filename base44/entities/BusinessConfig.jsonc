{
  "name": "BusinessConfig",
  "type": "object",
  "description": "Single source of truth for all business configuration \u2014 vehicle classifications, pricing groups, services, pricing rules, memberships, hours, scheduling rules, feature flags, plan tier, branding, domain dictionary, AI concierge persona, SEO copy, and FAQ content. Designed multi-tenant (business_id) for the ERA Systems future. Business behavior is configurable here, not hardcoded. VDS Mobile is a configuration layer over ERA Core.",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "Unique identifier for this business (multi-tenant future)",
      "default": "vds"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Only one active config per business_id"
    },
    "business_name": {
      "type": "string",
      "default": "VDS Mobile"
    },
    "business_short_name": {
      "type": "string",
      "description": "Compact brand label for nav links and compact CTAs (e.g. 'VDS'). Falls back to business_name when unset."
    },
    "legal_name": {
      "type": "string",
      "description": "Legal entity name for copyright lines, footer legal notices, and contracts. May differ from the brand display name (business_name); e.g. VDS brand is 'VDS Mobile' but legal entity is 'Valet Detailing Service LLC'. Generic tenants often set legal_name = business_name."
    },
    "legal_jurisdiction": {
      "type": "string",
      "description": "State/region where the business is legally registered (e.g. 'Georgia'). Used in legal notices, Terms jurisdiction clauses, and 'registered LLC in {legal_jurisdiction}' phrasing. Populated by the onboarding wizard."
    },
    "logo_url": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "brand_colors": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "business_phone": {
      "type": "string"
    },
    "business_email": {
      "type": "string"
    },
    "business_ein": {
      "type": "string",
      "description": "Employer Identification Number (EIN). Required during onboarding so ERA can verify the business and build the client website."
    },
    "business_address": {
      "type": "string",
      "description": "Free-text display address (e.g. 'Metro Atlanta, GA'). For structured needs (JSON-LD PostalAddress, legal jurisdiction) use address_locality / address_region / address_country."
    },
    "address_locality": {
      "type": "string",
      "description": "Structured locality/city for JSON-LD PostalAddress (e.g. 'Alpharetta'). Populated by the onboarding wizard."
    },
    "address_region": {
      "type": "string",
      "description": "Structured state/region for JSON-LD PostalAddress (e.g. 'GA')."
    },
    "address_country": {
      "type": "string",
      "description": "ISO country code for JSON-LD PostalAddress (e.g. 'US')."
    },
    "service_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "business_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "open": {
            "type": "string",
            "description": "HH:MM 24h"
          },
          "close": {
            "type": "string",
            "description": "HH:MM 24h"
          },
          "closed": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "scheduling_rules": {
      "type": "object",
      "properties": {
        "booking_buffer_hours": {
          "type": "number",
          "default": 24
        },
        "min_notice_hours": {
          "type": "number",
          "default": 24
        },
        "cancellation_hours": {
          "type": "number",
          "default": 48
        },
        "slot_interval_minutes": {
          "type": "number",
          "default": 60
        },
        "max_bookings_per_day": {
          "type": "number",
          "default": 4
        }
      }
    },
    "pricing_rules": {
      "type": "object",
      "description": "Pricing engine rules \u2014 condition multipliers applied to computed quotes based on vehicle condition.",
      "properties": {
        "condition_multipliers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "multiplier": {
                "type": "number"
              },
              "duration_add_minutes": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "vehicle_classifications": {
      "type": "array",
      "description": "Operational vehicle classifications. Independent from pricing groups.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "coupe",
              "sedan",
              "hatchback",
              "mid_size_suv",
              "truck_3_row_suv",
              "other"
            ]
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "pricing_groups": {
      "type": "array",
      "description": "Pricing groups. Independently configurable from vehicle classifications.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "sedan_coupe",
              "truck_suv"
            ]
          },
          "label": {
            "type": "string"
          },
          "stripe_price_id": {
            "type": "string"
          }
        }
      }
    },
    "classification_to_pricing_group": {
      "type": "object",
      "description": "Mapping from vehicle classification to pricing group.",
      "properties": {
        "coupe": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        },
        "sedan": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        },
        "hatchback": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        },
        "mid_size_suv": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        },
        "truck_3_row_suv": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        },
        "other": {
          "type": "string",
          "enum": [
            "sedan_coupe",
            "truck_suv"
          ]
        }
      }
    },
    "vehicle_types": {
      "type": "array",
      "description": "Legacy vehicle type list. Retained for backward compatibility.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "feature_flags": {
      "type": "object",
      "description": "Platform feature flags \u2014 internal granular toggles within the plan_tier ceiling.",
      "properties": {
        "twilio_sms_enabled": {
          "type": "boolean",
          "default": false
        },
        "gold_checkout_enabled": {
          "type": "boolean",
          "default": true
        },
        "instant_quote_enabled": {
          "type": "boolean",
          "default": true
        },
        "web_chat_enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "automation_settings": {
      "type": "object",
      "description": "Per-automation on/off toggles. All default to true (an automation is off only when explicitly set to false). Email automations are available on Basic+; SMS automations on Growth+. The tier gate (planFeatures: email_automations / sms_automations) is checked in addition to the toggle, so a toggle is inert when the tier doesn't permit the channel. Booking confirmations are NOT here \u2014 they are always-on within the channel tier (no per-message toggle).",
      "properties": {
        "welcome_email": {
          "type": "boolean",
          "default": true,
          "description": "Welcome email to new members. Gated by email_automations (Basic+)."
        },
        "reminder_email": {
          "type": "boolean",
          "default": true,
          "description": "24-hour and 1-hour appointment reminder emails. Gated by email_automations (Basic+). Also the fallback channel for the 1-hour reminder when SMS can't fire."
        },
        "review_request_email": {
          "type": "boolean",
          "default": true,
          "description": "Post-detail review-request email. Gated by email_automations (Basic+). Fallback for review requests when SMS can't fire."
        },
        "reminder_sms": {
          "type": "boolean",
          "default": true,
          "description": "1-hour appointment reminder SMS. Gated by sms_automations (Growth+). When off (or tier unavailable), the 1-hour reminder falls back to email."
        },
        "review_request_sms": {
          "type": "boolean",
          "default": true,
          "description": "Post-detail review-request SMS. Gated by sms_automations (Growth+). When off (or tier unavailable), the review request falls back to email."
        }
      }
    },
    "plan_tier": {
      "type": "string",
      "enum": [
        "basic",
        "foundation",
        "growth",
        "enterprise"
      ],
      "default": "basic"
    },
    "ad_management_enabled": {
      "type": "boolean",
      "default": false
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "past_due",
        "canceled"
      ],
      "default": "active",
      "description": "Mirror of the Stripe subscription status for this tenant. Set by the Stripe webhook. 'active' = full access. 'past_due' = features retract immediately (Stripe retrying). 'canceled' = features stay live until grace_until passes, then retract."
    },
    "grace_until": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime. When subscription_status is 'canceled', features remain accessible until this date passes. Set to now + 7 days on subscription.deleted. Null when active or past_due."
    },
    "services": {
      "type": "array",
      "description": "Master service catalog.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "detail",
              "coating",
              "correction",
              "addon",
              "membership",
              "consultation"
            ]
          },
          "requires_consultation": {
            "type": "boolean",
            "default": false
          },
          "tiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tier": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                },
                "duration_minutes": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "featured_services": {
      "type": "array",
      "description": "Curated marketing service cards shown on the Home and Services pages.",
      "items": {
        "type": "object",
        "properties": {
          "service_key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "specs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "not_in_membership": {
            "type": "boolean",
            "default": false
          },
          "booking_preselect": {
            "type": "string"
          },
          "display_order": {
            "type": "number"
          }
        },
        "required": [
          "service_key",
          "title"
        ]
      }
    },
    "membership_plans": {
      "type": "array",
      "description": "Recurring membership plans.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "short_label": {
            "type": "string"
          },
          "stripe_product_id": {
            "type": "string"
          },
          "pricing_by_group": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pricing_group": {
                  "type": "string",
                  "enum": [
                    "sedan_coupe",
                    "truck_suv"
                  ]
                },
                "price_monthly": {
                  "type": "number"
                },
                "stripe_price_id": {
                  "type": "string"
                }
              }
            }
          },
          "benefits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "technicians": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        }
      }
    },
    "referral_program": {
      "type": "object",
      "description": "Partner Network incentive program.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "credit_amount": {
          "type": "number"
        },
        "incentives": {
          "type": "object",
          "properties": {
            "initial_detail": {
              "type": "number",
              "default": 30
            },
            "ceramic_coating": {
              "type": "number",
              "default": 100
            },
            "paint_correction": {
              "type": "number",
              "default": 100
            }
          }
        }
      }
    },
    "website_links": {
      "type": "object",
      "properties": {
        "booking_url": {
          "type": "string"
        },
        "gold_signup_url": {
          "type": "string"
        },
        "gallery_url": {
          "type": "string"
        },
        "google_review_url": {
          "type": "string"
        }
      }
    },
    "custom_domain": {
      "type": "string",
      "description": "Custom website domain the tenant has verified (e.g. 'bobsdetail.com'). When domain_status is 'verified', a TenantMapping entry routes this hostname to the tenant's business_id."
    },
    "domain_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "verified",
        "failed"
      ],
      "default": "none",
      "description": "Custom domain verification status. 'none' = no custom domain configured; 'pending' = DNS records generated, awaiting verification; 'verified' = DNS confirmed, domain is active; 'failed' = verification check did not pass."
    },
    "domain_verification_token": {
      "type": "string",
      "description": "Random token placed in a TXT record at _era-verify.<domain> for domain ownership verification. Generated by tenantSettings init_domain action."
    },
    "email_mode": {
      "type": "string",
      "enum": [
        "shared",
        "custom"
      ],
      "default": "shared",
      "description": "Email sending mode. 'shared' = uses the ERA Systems shared Resend domain (noreply@erasystems.com) with the business name as from_name \u2014 no DNS required. 'custom' = tenant verifies their own sending domain via Resend's per-tenant domain API for from@theirdomain.com sending."
    },
    "email_from_name": {
      "type": "string",
      "description": "Display name used as the email sender (from_name) when email_mode is 'shared'. Defaults to business_name."
    },
    "resend_domain_id": {
      "type": "string",
      "description": "Resend domain ID returned by POST /v1/domains when the tenant initializes custom email domain verification."
    },
    "email_domain_status": {
      "type": "string",
      "enum": [
        "shared",
        "pending",
        "verified",
        "failed"
      ],
      "default": "shared",
      "description": "Custom email domain verification status. 'shared' = using ERA Systems shared domain; 'pending' = Resend DNS records generated, awaiting verification; 'verified' = Resend confirmed the domain; 'failed' = verification rejected."
    },
    "social_links": {
      "type": "object",
      "properties": {
        "instagram": {
          "type": "string"
        },
        "tiktok": {
          "type": "string"
        }
      }
    },
    "seo": {
      "type": "array",
      "description": "Per-route SEO meta entries (page title + meta description), keyed by route path.",
      "items": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "faq": {
      "type": "array",
      "description": "FAQ entries (question + answer) shown on the FAQ page and emitted as FAQPage JSON-LD structured data.",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "dictionary": {
      "type": "object",
      "description": "White-label domain vocabulary for UI copy.",
      "properties": {
        "item_noun": {
          "type": "string",
          "default": "Vehicle"
        },
        "item_plural": {
          "type": "string",
          "default": "Vehicles"
        },
        "item_category_noun": {
          "type": "string",
          "default": "Classification"
        },
        "item_category_label": {
          "type": "string",
          "default": "Vehicle Classification"
        },
        "service_noun": {
          "type": "string",
          "default": "Detail"
        },
        "service_verb": {
          "type": "string",
          "default": "detail"
        },
        "service_area_noun": {
          "type": "string",
          "default": "Service Area"
        },
        "before_photo_label": {
          "type": "string",
          "default": "Before"
        },
        "after_photo_label": {
          "type": "string",
          "default": "After"
        },
        "appointment_noun": {
          "type": "string",
          "default": "Appointment"
        }
      }
    },
    "concierge": {
      "type": "object",
      "description": "AI concierge persona and branding.",
      "properties": {
        "name": {
          "type": "string",
          "default": "Valerie"
        },
        "persona": {
          "type": "string"
        },
        "business_summary": {
          "type": "string"
        },
        "greeting": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "business_id",
    "is_active",
    "business_name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.business_id": "{{user.data.business_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}