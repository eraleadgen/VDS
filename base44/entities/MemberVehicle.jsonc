{
  "name": "MemberVehicle",
  "type": "object",
  "properties": {
    "year": {
      "type": "string",
      "description": "Vehicle year"
    },
    "make": {
      "type": "string",
      "description": "Vehicle make (e.g. Porsche)"
    },
    "model": {
      "type": "string",
      "description": "Vehicle model (e.g. 911)"
    },
    "trim": {
      "type": "string",
      "description": "Trim level (e.g. Carrera S)"
    },
    "color": {
      "type": "string",
      "description": "Exterior color"
    },
    "interior_color": {
      "type": "string",
      "description": "Interior color"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "sedan_coupe",
        "truck_suv"
      ],
      "description": "Auto-classified vehicle class"
    },
    "license_plate": {
      "type": "string",
      "description": "License plate number"
    },
    "vin": {
      "type": "string",
      "description": "VIN (optional)"
    },
    "notes": {
      "type": "string",
      "description": "Special notes about this vehicle"
    },
    "previous_services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Quick-reference log of past services (structured history lives in ServiceRecord)"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Vehicle photo URLs"
    },
    "image_url": {
      "type": "string",
      "description": "Primary vehicle image URL"
    },
    "is_gold_registered": {
      "type": "boolean",
      "default": false,
      "description": "Whether this vehicle is enrolled in VDS Gold"
    }
  },
  "required": [
    "year",
    "make",
    "model"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}