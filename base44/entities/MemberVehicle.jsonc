{
  "name": "MemberVehicle",
  "type": "object",
  "properties": {
    "year": {
      "type": "string",
      "description": "Vehicle year"
    },
    "make": {
      "type": "string",
      "description": "Vehicle make (e.g. Porsche)"
    },
    "model": {
      "type": "string",
      "description": "Vehicle model (e.g. 911)"
    },
    "color": {
      "type": "string",
      "description": "Vehicle color"
    },
    "license_plate": {
      "type": "string",
      "description": "License plate number"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "sedan_coupe",
        "truck_suv"
      ],
      "description": "Auto-classified vehicle type"
    },
    "notes": {
      "type": "string",
      "description": "Any special notes about this vehicle"
    },
    "is_gold_registered": {
      "type": "boolean",
      "default": false,
      "description": "Whether this vehicle is enrolled in VDS Gold membership"
    }
  },
  "required": [
    "year",
    "make",
    "model"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}