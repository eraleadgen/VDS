{
  "name": "MemberVehicle",
  "type": "object",
  "description": "Vehicle Module. Operational record for a customer's vehicle. Vehicle classification is independent from pricing group \u2014 classification is operational data, pricing group is resolved via BusinessConfig mapping and drives pricing. A vehicle belongs to exactly one Customer and may have one active VDS Gold membership.",
  "properties": {
    "business_id": {
      "type": "string",
      "default": "vds",
      "description": "Tenant scope. Set on creation so entity RLS can match the user's tenant."
    },
    "customer_id": {
      "type": "string",
      "description": "Customer entity ID that owns this vehicle"
    },
    "nickname": {
      "type": "string",
      "description": "Customer-assigned vehicle nickname (e.g. 'The Beast')"
    },
    "year": {
      "type": "string",
      "description": "Vehicle year"
    },
    "make": {
      "type": "string",
      "description": "Vehicle make (e.g. Porsche)"
    },
    "model": {
      "type": "string",
      "description": "Vehicle model (e.g. 911)"
    },
    "trim": {
      "type": "string",
      "description": "Trim level (e.g. Carrera S)"
    },
    "color": {
      "type": "string",
      "description": "Exterior color"
    },
    "interior_color": {
      "type": "string",
      "description": "Interior color"
    },
    "vehicle_classification": {
      "type": "string",
      "enum": [
        "coupe",
        "sedan",
        "hatchback",
        "mid_size_suv",
        "truck_3_row_suv",
        "other"
      ],
      "description": "Operational vehicle classification. Independent from pricing group. Drives scheduling and specialist matching."
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "sedan_coupe",
        "truck_suv"
      ],
      "description": "Legacy pricing group field. Retained for backward compatibility during migration. New code should use pricing_group derived from vehicle_classification via BusinessConfig mapping."
    },
    "pricing_group": {
      "type": "string",
      "enum": [
        "sedan_coupe",
        "truck_suv"
      ],
      "description": "Pricing group resolved from vehicle_classification via BusinessConfig classification_to_pricing_group mapping. Drives pricing lookups."
    },
    "license_plate": {
      "type": "string"
    },
    "vin": {
      "type": "string",
      "description": "VIN (optional)"
    },
    "mileage": {
      "type": "number",
      "description": "Current mileage (optional)"
    },
    "paint_protection_type": {
      "type": "string",
      "enum": [
        "none",
        "ceramic_coating",
        "ppf",
        "vinyl_wrap",
        "unknown"
      ],
      "default": "none",
      "description": "Existing paint protection on the vehicle"
    },
    "paint_protection_install_date": {
      "type": "string",
      "format": "date"
    },
    "paint_type": {
      "type": "string",
      "description": "Paint type if known (e.g. metallic, pearl, matte)"
    },
    "garage_kept": {
      "type": "boolean",
      "default": false
    },
    "primary_daily_driver": {
      "type": "boolean",
      "default": false
    },
    "current_condition": {
      "type": "string",
      "description": "Free-text current condition notes"
    },
    "notes": {
      "type": "string",
      "description": "Special notes about this vehicle"
    },
    "previous_services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Quick-reference log of past services (structured history lives in ServiceRecord)"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Vehicle photo URLs"
    },
    "image_url": {
      "type": "string",
      "description": "Primary vehicle image URL"
    },
    "is_gold_registered": {
      "type": "boolean",
      "default": false,
      "description": "Whether this vehicle is enrolled in VDS Gold"
    }
  },
  "required": [
    "business_id",
    "year",
    "make",
    "model"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}