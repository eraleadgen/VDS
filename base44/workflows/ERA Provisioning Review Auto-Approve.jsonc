{
  "name": "ERA Provisioning Review Auto-Approve",
  "description": "Hourly sweep: auto-approves any EraAccount still pending_review past its 24h review_deadline, then emails the member that their site is fully live.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "hours",
      "interval_anchor": "2026-08-22T05:10:54.956000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "era_provisioning_review_auto_approve",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "provisioningReview",
            "args": {
              "action": "auto_approve_past_deadline"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "provisioningReview"
  }
}